{
  "name": "gang",
  "version": "0.1.0",
  "description": "Minimal, observable subagent primitive for Pi — visible tmux members, cross-agent intercom, and a mission-control GUI.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "assets",
    "src/**/*.ts",
    "src/**/*.html",
    "src/**/SKILL.md",
    "!src/**/*.test.ts",
    "!src/**/test/**",
    "NOTICE"
  ],
  "scripts": {
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./src/intercom/index.ts",
      "./src/gang/index.ts"
    ],
    "skills": [
      "./src/intercom/skills"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "@earendil-works/pi-tui": "^0.80.2",
    "@types/node": "^22.20.0",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "tsx": "^4.22.4"
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jeecabs/gang.git"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/Jeecabs/gang/issues"
  },
  "homepage": "https://github.com/Jeecabs/gang#readme"
}
