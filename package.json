{
  "name": "pi-gang",
  "version": "0.1.0",
  "description": "Minimal, observable subagent primitive for Pi — visible tmux members, cross-agent intercom, and a mission-control GUI.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "assets",
    "src/**/*.ts",
    "src/**/*.mjs",
    "src/**/*.mts",
    "src/**/*.html",
    "src/**/*.md",
    "!src/**/*.test.ts",
    "!src/**/test/**",
    "NOTICE"
  ],
  "scripts": {
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "pi": {
    "extensions": [
      "./src/intercom/index.ts",
      "./src/gang/index.ts"
    ],
    "skills": [
      "./src/intercom/skills",
      "./src/gang/skills"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.85.1 <0.86.0",
    "@earendil-works/pi-coding-agent": ">=0.85.1 <0.86.0",
    "@earendil-works/pi-tui": ">=0.85.1 <0.86.0",
    "typebox": ">=1.3.7 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^22.20.3",
    "pi-intercom": "0.15.0",
    "typebox": "^1.3.32",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "tsx": "^4.23.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jeecabs/gang.git"
  },
  "author": "Lachlan Jacobs",
  "bugs": {
    "url": "https://github.com/Jeecabs/gang/issues"
  },
  "homepage": "https://github.com/Jeecabs/gang#readme",
  "publishConfig": {
    "access": "public"
  }
}
